{
  "schema": 1,
  "authorship": "Hand-written ground truth, before real model evaluation",
  "proposal": {
    "input_space": {
      "confirmed": [
        false,
        true
      ],
      "vip": [
        false,
        true
      ]
    },
    "rules": [
      {
        "id": "A",
        "quote": "Unconfirmed bookings stay in the pending queue, VIP or not.",
        "when": {
          "confirmed": {
            "eq": false
          }
        },
        "action": "pending"
      },
      {
        "id": "B",
        "quote": "Also, Confirmed bookings reserve a seat.",
        "when": {
          "confirmed": {
            "eq": true
          }
        },
        "action": "reserve"
      }
    ],
    "default": {
      "quote": "Use pending for any otherwise unmatched booking.",
      "action": "pending"
    },
    "unconverted": []
  },
  "clashes": [],
  "action_aliases": {
    "pending": [
      "pending",
      "queue_pending"
    ],
    "reserve": [
      "reserve",
      "reserve_seat"
    ]
  }
}
