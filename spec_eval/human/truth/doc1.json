        "id": "A",
        "quote": "If the posting is more than 30 days old, mark it stale.",
        "when": {
          "posting_over_30_days": {
            "eq": true
          }
        },
        "action": "stale"
      },
      {
        "id": "B",
        "quote": "Anything at one of my top companies stays active.",
        "when": {
          "top_company": {
            "eq": true
          }
        },
        "action": "active"
      },
      {
        "id": "C",
        "quote": "If it's been over 3 weeks and I haven't heard back, send a follow-up, but only for postings that aren't stale and aren't at a top company.",
        "when": {
          "posting_over_30_days": {
            "eq": false
          },
          "top_company": {
            "eq": false
          },
          "applied_over_3_weeks": {
            "eq": true
          },
          "heard_back": {
            "eq": false
          }
        },
        "action": "follow_up"
      }
    ],
    "default": {
      "quote": "Otherwise, just wait.",
      "action": "wait"
    },
    "unconverted": []
  },
