{
  "id": "rate-limit",
  "split": "dev",
  "domain": "rate-limit",
  "solvable": {
    "id": "rate-limit-solvable",
    "pair": "rate-limit",
    "version": 1,
    "default": "allow",
    "input_space": {
      "over_limit": [
        false,
        true
      ],
      "internal": [
        false,
        true
      ],
      "context": [
        "read",
        "write"
      ]
    },
    "rules": [
      {
        "id": "A",
        "text": "Block clients above their quota. Applies only if internal is false.",
        "when": {
          "over_limit": {
            "eq": true
          },
          "internal": {
            "eq": false
          }
        },
        "action": "block"
      },
      {
        "id": "B",
        "text": "Allow internal clients through.",
        "when": {
          "internal": {
            "eq": true
          }
        },
        "action": "allow"
      }
    ]
  },
