{
  "id": "retry",
  "split": "dev",
  "domain": "retry",
  "solvable": {
    "id": "retry-solvable",
    "pair": "retry",
    "version": 1,
    "default": "stop",
    "rules": [
      {
        "id": "A",
        "text": "Retry every HTTP 429 response. Applies only when idempotent is true.",
        "when": {
          "status": {
            "eq": 429
          },
          "idempotent": {
            "eq": true
          }
        },
        "action": "retry"
      },
      {
        "id": "B",
        "text": "Never retry a non-idempotent POST.",
        "when": {
          "method": {
            "eq": "POST"
          },
          "idempotent": {
            "eq": false
          }
        },
        "action": "stop"
      }
    ],
    "input_space": {
      "method": [
        "GET",
        "POST",
        "PUT",
        "PATCH"
      ],
      "status": [
        200,
        429,
        503
      ],
      "idempotent": [
        false,
        true
      ]
    }
  },
