    "solvable": "def solve(x):\n    if (x[\"status\"]==429) and (x[\"idempotent\"] is True): return 'retry'\n    if x[\"method\"]==\"POST\" and x[\"idempotent\"] is False: return 'stop'\n    return 'stop'\n",
