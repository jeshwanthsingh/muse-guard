{
  "schema_version": 1,
  "study": "recovery-paired-v1",
  "development_pairs": 10,
  "holdout_pairs": 20,
  "repeats": 2,
  "modes": [
    "plain",
    "guarded"
  ],
  "model": "muse-spark-1.3",
  "pricing_mode": "STANDARD",
