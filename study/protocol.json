  "daily_limit_usd": 5,
  "decision_policy": "B wins on verified guarded conflicts",
  "order_seed": 20261026,
  "labels": [
    "PASS",
    "TASK FAILURE",
    "UNAUTHORIZED TEST CHANGE",
    "CONFLICT REPORTED",
